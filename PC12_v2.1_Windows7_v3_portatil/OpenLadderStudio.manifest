<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifesto embutido em todos os executáveis do OpenLadder Studio pelo
  /win32manifest do compilador. Sem ele o Windows trata o processo como
  DPI-unaware e amplia a janela como bitmap, deixando a interface borrada
  em telas com escala de 125%, 150% ou 200%.

  A declaração é de reconhecimento de DPI do sistema (dpiAware = true), e
  não per-monitor: per-monitor exigiria suporte de re-layout que o
  WinForms desta versão não oferece, e a compatibilidade com Windows 7 é
  um objetivo declarado do projeto.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <assemblyIdentity version="1.0.0.0" name="OpenLadderStudio" type="win32" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- Coerente com PrivilegesRequired=lowest no instalador. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <!-- Windows 10 e Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </windowsSettings>
  </application>

</assembly>
