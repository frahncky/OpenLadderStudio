  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>OpenLadderStudio.WinForms</RootNamespace>
    <!-- ProcessSynoptic.cs é compartilhado com o build legado (csc do .NET Framework, C# 5),
         que não aceita anotações de nulabilidade. -->
