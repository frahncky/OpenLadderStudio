<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Mesma versão do produto distribuído (Ajuda > Sobre). -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)src/OpenLadderStudio.Desktop/version.txt').Trim())</Version>
  </PropertyGroup>
</Project>
